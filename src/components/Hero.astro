---
import ikonaZegar from "../assets/svg/zegar.svg";
---

<section class="w-full pt-space-xl-3xl">
  <!-- Kontener 1400px -->
  <div class="site-wrapper flex flex-col gap-y-12 lg:gap-y-16">
    <!-- 1. GÓRNY WIERSZ: 2 kolumny (Tekst + Grafika) -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-space-s lg:gap-12 items-center w-full"
    >
      <!-- LEWA KOLUMNA: Teksty -->
      <div class="flex flex-col justify-center items-start text-left w-full">
        <!-- Nadtytuł w JetBrains Mono -->
        <p
          class="font-mono text-step--1 font-medium tracking-[0.18em] text-primary uppercase mb-space-xs"
        >
          PRODUCENT KARTONÓW OZDOBNYCH OD 2005
        </p>

        <!-- Nagłówek H1: dokładnie 2 linijki z miękkim łamaniem -->
        <h1
          class="font-heading text-step-4 font-bold text-body tracking-tight leading-[1.08] mb-space-s"
        >
          Opakowanie, które <br class="hidden sm:inline" />
          <span class="text-primary">domyka</span> Twój produkt
        </h1>

        <!-- Lead paragraph -->
        <p
          class="text-step-0 text-body/90 font-normal leading-relaxed max-w-xl"
        >
          Projektujemy i produkujemy kartony ozdobne dla marek, które liczą się
          z detalem — od pierwszego szkicu po paletę gotową do wysyłki. <strong
            >Zaufaj nam.</strong
          >
        </p>
      </div>

      <!-- PRAWA KOLUMNA: Obrazek / Placeholder -->
      <div class="w-full h-full min-h-[360px] lg:min-h-[420px] flex">
        <div
          class="relative w-full h-full bg-[#f0f1f2] overflow-hidden flex items-center justify-center rounded-sm"
        >
          <svg
            viewBox="0 0 700 550"
            class="w-full h-full object-cover"
            fill="none"
            preserveAspectRatio="xMidYMid slice"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M-50 340 Q350 290 750 380 L750 600 L-50 600 Z"
              fill="#e2e4e6"></path>
            <path
              d="M-50 420 Q350 370 750 460 L750 600 L-50 600 Z"
              fill="#d4d7da"></path>
            <path
              d="M-50 340 Q350 290 750 380"
              stroke="#bcc1c6"
              stroke-width="3"></path>

            <g opacity="0.6">
              <rect
                x="70"
                y="320"
                width="160"
                height="90"
                fill="#fcfcfc"
                stroke="#cfd3d8"
                stroke-width="2"></rect>
              <path
                d="M230 340 L270 340 L280 375 L280 410 L230 410 Z"
                fill="#e8eaed"></path>
              <rect x="235" y="348" width="30" height="22" fill="#ffffff"
              ></rect>
              <circle cx="110" cy="415" r="14" fill="#70757a"></circle>
              <circle cx="190" cy="415" r="14" fill="#70757a"></circle>
              <circle cx="255" cy="415" r="14" fill="#70757a"></circle>
            </g>

            <g>
              <rect x="280" y="290" width="280" height="135" fill="#e72120"
              ></rect>
              <rect x="280" y="290" width="280" height="15" fill="#f04b4a"
              ></rect>

              <path
                d="M560 325 L620 325 L645 375 L645 425 L560 425 Z"
                fill="#d2d7dc"></path>
              <polygon
                points="568,335 612,335 628,372 568,372"
                fill="#edf2f7"
                stroke="#b8bec5"
                stroke-width="1.5"></polygon>
              <rect x="635" y="405" width="15" height="18" fill="#a0a6ad"
              ></rect>

              <circle cx="350" cy="435" r="24" fill="#202124"></circle>
              <circle cx="350" cy="435" r="11" fill="#5f6368"></circle>

              <circle cx="500" cy="435" r="24" fill="#202124"></circle>
              <circle cx="500" cy="435" r="11" fill="#5f6368"></circle>

              <circle cx="615" cy="435" r="22" fill="#202124"></circle>
              <circle cx="615" cy="435" r="10" fill="#5f6368"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- 2. DOLNY WIERSZ: Rozłożony od krawędzi do krawędzi (od lewej do prawej) -->
    <div
      class="w-full pt-8 grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8 items-center"
    >
      <!-- Pozycja 1: Lico do lewej krawędzi tekstu -->
      <div class="flex flex-col items-center lg:items-start text-left w-full">
        <div
          class="font-heading text-step-1 font-bold text-body tracking-tight leading-none min-h-[45px] flex items-center justify-start"
        >
          <span><span class="text-primary">1 000</span> 000+</span>
        </div>
        <p class="text-step-0 text-body/80 mt-2 font-normal leading-snug">
          kartonów rocznie
        </p>
      </div>

      <!-- Pozycja 2: Środek -->
      <div class="flex flex-col items-center text-center w-full">
        <div class="min-h-[45px] flex items-center justify-center">
          <img
            src={ikonaZegar.src}
            alt="Szybki czas realizacji"
            class="w-[45px] h-[45px] object-contain"
            loading="lazy"
          />
        </div>
        <p class="text-step-0 text-body/80 mt-2 font-normal leading-snug">
          Szybki czas realizacji
        </p>
      </div>

      <!-- Pozycja 3: Środek -->
      <div class="flex flex-col items-center text-center w-full">
        <div
          class="font-heading text-step-1 font-bold text-body tracking-tight leading-none min-h-[45px] flex items-center justify-center"
        >
          <span><span class="text-primary">3</span>x</span>
        </div>
        <p class="text-step-0 text-body/80 mt-2 font-normal leading-snug">
          kontrola jakości
        </p>
      </div>

      <!-- Pozycja 4: Dociągnięty do prawej krawędzi kontenera -->
      <div class="flex items-center justify-end w-full">
        <a
          href="#oferta"
          class="inline-flex items-center justify-center gap-3 w-full sm:w-[205px] h-[45px] bg-primary text-[14px] font-medium uppercase tracking-wider leading-none text-white hover:bg-secondary transition-colors duration-300 ease-out cursor-pointer whitespace-nowrap shadow-sm"
        >
          <span>ZOBACZ OFERTĘ</span>
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
