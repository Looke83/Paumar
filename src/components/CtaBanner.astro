---
interface Props {
  hasNegativeMargin?: boolean;
}

const { hasNegativeMargin = true } = Astro.props;
---

<section
  id="wycena"
  class:list={[
    "w-full bg-primary text-white",
    hasNegativeMargin && "-mt-[var(--spacing-section-gap)]",
  ]}
>
  <!-- Sprawdzony wewnętrzny fluid padding na site-wrapper -->
  <div
    class="site-wrapper flex flex-col items-center text-center pt-[var(--spacing-space-xl-3xl)] pb-[var(--spacing-space-m-xl)]"
  >
    <!-- Nagłówek CTA -->
    <h2
      class="font-heading text-step-3 font-bold tracking-tight !text-white leading-tight pb-[var(--spacing-space-s-m)]"
    >
      Porozmawiajmy o Twoim kartonie.
    </h2>

    <!-- Tekst pomocniczy z wyraźnym dolnym odstępem odpychającym przycisk -->
    <p
      class="text-step-0 text-white/95 font-normal leading-relaxed max-w-2xl pb-[var(--spacing-space-m-xl)]"
    >
      Wyślij zapytanie, a nasz zespół przygotuje wycenę w ciągu 24 godzin.
    </p>

    <!-- Przycisk z pełną animacją hover i płynnym przejściem ease-out -->
    <a
      href="/kontakt"
      class="inline-flex items-center justify-center min-w-[210px] h-[48px] px-8 bg-white text-primary border-2 border-white hover:bg-transparent hover:text-white transition-all duration-300 ease-out font-heading text-[13px] sm:text-[14px] font-semibold uppercase tracking-wider select-none cursor-pointer"
    >
      ZAPYTAJ O WYCENĘ
    </a>
  </div>
</section>
