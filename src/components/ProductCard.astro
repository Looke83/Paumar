---
import { Image } from "astro:assets";
import placeholderImg from "../assets/placeholder.png";

interface Props {
  dimensions?: string;
  titleBlack: string;
  titleRed: string;
  description: string;
  imageSrc?: ImageMetadata;
  href?: string;
}

const {
  dimensions = "H120 · W300 · D200",
  titleBlack,
  titleRed,
  description,
  imageSrc = placeholderImg,
  href = "#",
} = Astro.props;
---

<!-- Karta: fluid padding p-space-s-m, maksymalna szerokość 448px na 1400px -->
<div
  class="group relative bg-white p-space-s-m w-full max-w-[448px] transition-all duration-300 ease-out border border-dotted border-neutral-400/80 hover:-translate-y-2 hover:shadow-2xl flex flex-col justify-between"
>
  <!-- KRZYŻAKI W NAROŻNIKACH -->
  <span
    class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center w-[18px] h-[18px] pointer-events-none select-none z-10 text-neutral-900"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <line x1="9" y1="0" x2="9" y2="18"></line>
      <line x1="0" y1="9" x2="18" y2="9"></line>
    </svg>
  </span>

  <span
    class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 flex items-center justify-center w-[18px] h-[18px] pointer-events-none select-none z-10 text-neutral-900"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <line x1="9" y1="0" x2="9" y2="18"></line>
      <line x1="0" y1="9" x2="18" y2="9"></line>
    </svg>
  </span>

  <span
    class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 flex items-center justify-center w-[18px] h-[18px] pointer-events-none select-none z-10 text-neutral-900"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <line x1="9" y1="0" x2="9" y2="18"></line>
      <line x1="0" y1="9" x2="18" y2="9"></line>
    </svg>
  </span>

  <span
    class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 flex items-center justify-center w-[18px] h-[18px] pointer-events-none select-none z-10 text-neutral-900"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <line x1="9" y1="0" x2="9" y2="18"></line>
      <line x1="0" y1="9" x2="18" y2="9"></line>
    </svg>
  </span>

  <div>
    <!-- Zdjęcie z fluid marginesem mb-space-s -->
    <div
      class="relative w-full aspect-[4/3] bg-neutral-200 overflow-hidden mb-space-s"
    >
      <!-- Czerwona ramka techniczna: przezroczysta, idealnie w lewym górnym rogu -->
      <div
        class="absolute top-0 left-0 z-10 border border-primary bg-transparent px-2.5 py-1 text-[11px] font-mono text-primary flex items-center gap-2"
      >
        <span class="w-1.5 h-1.5 bg-primary shrink-0" aria-hidden="true"></span>
        <span class="tracking-wider uppercase font-medium">{dimensions}</span>
      </div>

      <Image
        src={imageSrc}
        alt={`Karton ozdobny - ${titleBlack} ${titleRed}`}
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    </div>

    <!-- Tytuł: fluid font text-step-1 z fluid marginem mb-space-2xs -->
    <h3
      class="font-heading text-step-1 font-bold tracking-tight text-body mb-space-2xs"
    >
      {titleBlack}{" "}<span class="text-primary">{titleRed}</span>
    </h3>

    <!-- Opis: fluid font text-step-0 (16px do 18px) -->
    <p class="text-step-0 text-neutral-600 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <a href={href} class="absolute inset-0 z-20">
    <span
      class="sr-only focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
      >Zobacz {titleBlack} {titleRed}</span
    >
  </a>
</div>
