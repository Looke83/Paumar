---
const pillars = [
  {
    icon: "corrugation",
    title: "Tektura falista premium",
    desc: "Surowiec z certyfikatem FSC®, dobrany pod wagę i kształt produktu.",
  },
  {
    icon: "clock",
    title: "Szybka realizacja",
    desc: "Od projektu do produkcji - oferujemy błyskawiczną realizację zamówienia",
  },
  {
    icon: "check",
    title: "Kontrola jakości 3x",
    desc: "Każda partia sprawdzana na etapie cięcia, druku i pakowania.",
  },
  {
    icon: "office",
    title: "Biuro projektowe",
    desc: "Od pomysłu po dieline — projektujemy karton dopasowany do produktu.",
  },
];
---

<section class="w-full">
  <div class="site-wrapper">
    
   <!-- 1. TECHNICZNA LINIA CIĘCIA Z NOŻYCZKAMI -->
    <div 
      class="relative w-full -mt-[calc(var(--spacing-section-gap)/2)] mb-[calc(var(--spacing-section-gap)/2)] select-none pointer-events-none"
    >
      <!-- Linia kropkowana na pełną szerokość -->
      <div class="w-full border-b border-dotted border-neutral-300"></div>

      <!-- Nożyczki LEWE: oczka po lewej, skrzyżowane ostrza tną w prawo -->
      <span class="absolute left-6 sm:left-12 top-1/2 -translate-y-1/2 bg-white px-2 text-neutral-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <!-- Oczka -->
          <circle cx="5" cy="7" r="3"></circle>
          <circle cx="5" cy="17" r="3"></circle>
          <!-- Ramię z lewej góry przechodzące przez środek w prawe dolne ostrze -->
          <line x1="7.5" y1="8.5" x2="21" y2="17.5"></line>
          <!-- Ramię z lewego dołu przechodzące przez środek w prawe górne ostrze -->
          <line x1="7.5" y1="15.5" x2="21" y2="6.5"></line>
        </svg>
      </span>

      <!-- Nożyczki PRAWE: oczka po lewej, skrzyżowane ostrza tną w prawo -->
      <span class="absolute right-6 sm:right-12 top-1/2 -translate-y-1/2 bg-white px-2 text-neutral-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <!-- Oczka -->
          <circle cx="5" cy="7" r="3"></circle>
          <circle cx="5" cy="17" r="3"></circle>
          <!-- Ramię z lewej góry przechodzące przez środek w prawe dolne ostrze -->
          <line x1="7.5" y1="8.5" x2="21" y2="17.5"></line>
          <!-- Ramię z lewego dołu przechodzące przez środek w prawe górne ostrze -->
          <line x1="7.5" y1="15.5" x2="21" y2="6.5"></line>
        </svg>
      </span>
    </div>
    
<!-- 2. NAGŁÓWEK SEKCJI I PRAWA NOTATKA -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-s mb-space-l">
      <!-- Lewa strona: nadtytuł + H2 -->
      <div class="max-w-3xl">
        <p class="font-mono text-step--1 font-medium tracking-[0.18em] text-primary uppercase mb-space-2xs">
          DLACZEGO PAUMAR
        </p>
        <h2 class="font-heading text-step-3 font-bold tracking-tight text-body leading-[1.12]">
          Zbudowane <span class="text-primary">warstwa</span> po warstwie
        </h2>
      </div>

      <!-- Prawa strona: Lead tekstu z projektu -->
      <div class="max-w-xs lg:text-left">
        <p class="text-step-0 text-body/90 font-normal leading-relaxed">
          Jak sama tektura falista — nasza jakość powstaje z kilku solidnych warstw.
        </p>
      </div>
    </div>

    <!-- 3. SIATKA 4 KOLUMN Z RAMKAMI TECHNICZNYMI -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-neutral-300">
      {
        pillars.map((item) => (
          <div class="border-r border-b border-neutral-300 p-space-s-m flex flex-col justify-between min-h-[220px] bg-white">
            
            <!-- Górna ikona -->
            <div class="mb-space-m text-primary">
              {item.icon === "corrugation" && (
                <svg class="w-7 h-7 stroke-[1.8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18v12H3z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13c3-4 6 4 9 0s6 4 9 0" />
                </svg>
              )}

              {item.icon === "clock" && (
                <svg class="w-7 h-7 stroke-[1.8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
                </svg>
              )}

              {item.icon === "check" && (
                <svg class="w-7 h-7 stroke-[1.8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="1" stroke-linecap="round" stroke-linejoin="round" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-6" />
                </svg>
              )}

              {item.icon === "office" && (
                <svg class="w-7 h-7 stroke-[1.8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 9h1m4 0h1m-6 4h1m4 0h1m-4 8v-4h2v4" />
                </svg>
              )}
            </div>

            <!-- Teksty: Tytuł + Opis -->
            <div>
              <h3 class="font-heading text-step-0 font-bold tracking-tight text-body mb-space-2xs">
                {item.title}
              </h3>
              <p class="text-step--1 text-neutral-600 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>