---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import placeholderBox from "../assets/placeholder.png";
import CTABanner from "../components/CTABanner.astro";
---

<Layout title="Rozmiary Kartonów | PAUMAR">
  <Header />

  <main class="w-full pt-12 md:pt-16 pb-0 mb-28 md:mb-64">
    <div class="site-wrapper">
      <!-- 1. Nagłówek podstrony -->
      <div class="mb-12 md:mb-16 text-left">
        <h1
          class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-body mb-6"
        >
          <span class="text-primary">Certyfikaty</span>
        </h1>
        <p
          class="text-step-0 text-body/80 font-normal leading-relaxed text-left"
        >
          Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam
          nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat
          volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation
          ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.
          Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse
          molestie consequat, vel illum dolore eu feug
        </p>
      </div>

      <!-- 2. Sekcja z wierszami w proporcji 1/3 (obrazek) do 2/3 (tekst) -->
      <section class="w-full flex flex-col gap-y-16 md:gap-y-24">
        <!-- Wiersz 1 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch"
        >
          <!-- Lewa kolumna: 1/3 szerokości (4 z 12 kolumn) -->
          <div class="lg:col-span-4 flex justify-start items-center w-full">
            <div class="w-full flex items-center justify-start">
              <img
                src={placeholderBox.src}
                alt="Certyfikat"
                class="w-full h-auto max-h-[260px] object-contain object-left block"
                loading="eager"
              />
            </div>
          </div>

          <!-- Prawa kolumna: 2/3 szerokości (8 z 12 kolumn) -->
          <div
            class="lg:col-span-8 w-full flex flex-col justify-center text-left text-step-0 text-body/85 font-normal leading-relaxed"
          >
            Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam
            nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat
            volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation
            ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo
            consequat. Duis autem vel eum iriure dolor in hendrerit in vulputate
            velit esse molestie consequat, vel illum dolore eu feug
          </div>
        </div>

        <!-- Wiersz 2 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch"
        >
          <!-- Lewa kolumna: 1/3 szerokości (4 z 12 kolumn) -->
          <div class="lg:col-span-4 flex justify-start items-center w-full">
            <div class="w-full flex items-center justify-start">
              <img
                src={placeholderBox.src}
                alt="Certyfikat"
                class="w-full h-auto max-h-[260px] object-contain object-left block"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Prawa kolumna: 2/3 szerokości (8 z 12 kolumn) -->
          <div
            class="lg:col-span-8 w-full flex flex-col justify-center text-left text-step-0 text-body/85 font-normal leading-relaxed"
          >
            Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam
            nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat
            volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation
            ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo
            consequat. Duis autem vel eum iriure dolor in hendrerit in vulputate
            velit esse molestie consequat, vel illum dolore eu feug
          </div>
        </div>

        <!-- Wiersz 3 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch"
        >
          <!-- Lewa kolumna: 1/3 szerokości (4 z 12 kolumn) -->
          <div class="lg:col-span-4 flex justify-start items-center w-full">
            <div class="w-full flex items-center justify-start">
              <img
                src={placeholderBox.src}
                alt="Certyfikat"
                class="w-full h-auto max-h-[260px] object-contain object-left block"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Prawa kolumna: 2/3 szerokości (8 z 12 kolumn) -->
          <div
            class="lg:col-span-8 w-full flex flex-col justify-center text-left text-step-0 text-body/85 font-normal leading-relaxed"
          >
            Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam
            nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat
            volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation
            ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo
            consequat. Duis autem vel eum iriure dolor in hendrerit in vulputate
            velit esse molestie consequat, vel illum dolore eu feug
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- 4. Baner CTA -->
  <div class="w-full clear-both">
    <CTABanner hasNegativeMargin={false} />
  </div>

  <Footer />
</Layout>
